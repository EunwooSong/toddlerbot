# Component Ablation: Thermal Obs OFF, Derating OFF
# 온도 관측 없음 + sim derating 없음 → 열적 영향 완전 제거
# 비교: 열 정보가 전혀 없을 때 (사실상 baseline과 동일한 학습 환경)

ThermalEnvConfig.model_order_2 = True
ThermalEnvConfig.use_derate = False   # OFF
ThermalEnvConfig.use_thermal = False  # OFF
ThermalEnvConfig.use_w_offset = False

ThermalObsConfig.obs_h_clip_range = [25.0, 85.0]
ThermalObsConfig.obs_num = []   # OFF

ThermalRewardScales.safety_penalty = 0.0  # 온도 정보 없으므로 0
ThermalRewardScales.cbf_penalty = 0.0

ColdToHotCurriculumConfig.threshold_ratio = 0.5
ColdToHotCurriculumConfig.use_ep_sampling = True
ColdToHotCurriculumConfig.init_cold = [15.0, 30.0]
ColdToHotCurriculumConfig.init_hot = [45.0, 65.0]
