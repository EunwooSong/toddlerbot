# Component Ablation: Thermal Obs OFF, Derating ON
# 온도 관측 없이 sim에서만 torque derating 적용
# 비교: derating으로 인해 policy가 간접적으로 고온 영향을 느끼지만, 온도는 관측 불가

ThermalEnvConfig.model_order_2 = True
ThermalEnvConfig.use_derate = True    # ON
ThermalEnvConfig.use_thermal = True
ThermalEnvConfig.use_w_offset = True

ThermalObsConfig.obs_h_clip_range = [25.0, 85.0]
ThermalObsConfig.obs_num = []   # OFF

ThermalRewardScales.safety_penalty = 0.2
ThermalRewardScales.cbf_penalty = 0.0

# Safety Wrapper: 전체 모터, 기본 패널티
