# Energy Penalty Ablation: 10x (열 모델 없음)
# energy = 0.50 (기본값의 10배)

ThermalEnvConfig.model_order_2 = False
ThermalEnvConfig.use_derate = False
ThermalEnvConfig.use_thermal = False
ThermalEnvConfig.use_w_offset = False

ThermalObsConfig.obs_h_clip_range = [25.0, 85.0]
